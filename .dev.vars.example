# Better-Auth
BETTER_AUTH_SECRET=replace-with-32+char-random-string
BETTER_AUTH_URL=http://localhost:3000
# Email — blank keys keep mail local: captured to the console, never sent.
# Which provider sends is EMAIL_PROVIDER: `resend` (default) or `flowmails`.
# Only the selected provider's key is read — there is no fallback from one to
# the other, so a half-finished switch degrades to the console instead of
# quietly mailing through the wrong service.
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FLOWMAILS_APIKEY=
# Sender. Either a bare address or `Display Name <address>`; the name is split
# off for providers that take it separately (Flowmails). Flowmails requires an
# address on the domain its key is bound to — anything else is rejected.
EMAIL_FROM=FlareStarter <onboarding@resend.dev>
# Email verification on sign-up. Unset/blank = true, same as `true`.
# Set to false to let a new account straight into the dashboard (no inbox round
# trip) — only sensible for a private/demo deploy, since anyone can then sign up
# with someone else's address. `true` still needs the selected provider's key
# above: without it verification stays off, because the link would never be
# delivered.
AUTH_EMAIL_VERIFY=
# Optional: Resend audience id for the waitlist (and future newsletter).
# Leave blank to disable audience sync — signups still save to D1.
RESEND_AUDIENCE_ID=
# Social OAuth — blank hides that provider's button
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
# ── Billing ─────────────────────────────────────────────────────────────────
# Which vendors the checkout page offers. Comma-separated ids:
#   stripe, waffo, creem, paypal   (any subset, in any order)
# Unset or empty = ALL of them — each is still gated on its own secrets below, so
# this cannot enable anything you have not configured. To turn one off, remove
# its id from this list.
BILLING_PROVIDERS=
#
# Product ids are NOT here — they live with the tiers they belong to, in
# src/features/billing/plans.ts (`productIds` per tier and interval).

# Stripe. Forward webhooks locally with `stripe listen --forward-to
# localhost:3000/api/webhooks/stripe`.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# prod selects production keys/endpoints; anything else is test/sandbox.
WAFFO_ENV=
CREEM_ENV=
PAYPAL_ENV=

# Waffo Pancake — RSA keypair. The private key may be raw PEM (with literal or
# \n-escaped newlines) or base64 via WAFFO_PRIVATE_KEY_BASE64. The webhook public
# key is REQUIRED: without it the SDK falls back to its own bundled keypair,
# which we do not trust, so Waffo hides itself instead.
WAFFO_MERCHANT_ID=
WAFFO_PRIVATE_KEY=
WAFFO_PRIVATE_KEY_BASE64=
WAFFO_WEBHOOK_PUBLIC_KEY=

# Creem — both keys required; Creem refuses to construct without the webhook
# secret even if you never register a webhook.
CREEM_API_KEY=
CREEM_WEBHOOK_SECRET=

# PayPal — all three required. PA..._WEBHOOK_ID is the WH-... id from the webhook
# you create in the dashboard; it is part of PayPal's verification call.
# Without it PayPal can mint checkouts but cannot record completions.
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_WEBHOOK_ID=
# WeChat Pay on one-time sponsorships, via Stripe's wechat_pay — no WeChat merchant
# account needed. On by default once the Stripe keys are set, but you MUST first enable
# WeChat Pay in Stripe Dashboard -> Payment methods, or clicking it errors out. Set to
# false to pull it offline. Currency and FX rate: features/sponsor/sponsor.config.ts.
STRIPE_WECHAT_PAY_ENABLED=
# Admin — comma-separated emails; these get the admin role on signup/login
ADMIN_EMAILS=
# Cloudflare Turnstile bot protection (signup/login/password reset).
# Both blank = off, and the forms keep working. Create a widget at
# https://dash.cloudflare.com/?to=/:account/turnstile to get the keys.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Cloudflare Web Analytics (privacy-friendly, free). Blank = no beacon injected.
# Token lives in Dashboard -> Analytics & Logs -> Web Analytics.
CF_ANALYTICS_TOKEN=
# Sentry server-side error reporting. Blank = off. DSN is in the Sentry project settings.
SENTRY_DSN=
