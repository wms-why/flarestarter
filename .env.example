# Build-time configuration (Vite) — NOT `.dev.vars`.
#
# These values are read while `vite build` runs and are inlined into the bundle
# as literals. They are not runtime env vars: a Cloudflare var/secret only
# exists once the worker is running, which is far too late to keep a feature
# out of the bundle.
#
# Copy this file to `.env` (git-ignored) for local development, or set the
# variables in your CI environment for production builds.

# ── Brand ───────────────────────────────────────────────────────────────────
# This is the ONLY place to change the product's name. Every UI label, page
# title, SEO tag, structured-data blob, PayPal brand and the email sender name
# read from here (see src/lib/brand.ts) — no component hard-codes it.
#
# The i18n dictionaries contain a `{app}` placeholder that resolves to APP_NAME
# globally (see src/features/i18n/locale.ts), so you do NOT edit en.ts / zh.ts.
#
# Leave blank to keep the template's own name.

# Product name: UI titles, SEO, email sender display name, PayPal brand_name,
# structured data, web app manifest.
APP_NAME=FlareStarter

# Site root URL: the origin used for canonical / og:url.
# While this is still the template's *.example.com, the SEO origin falls back to
# BETTER_AUTH_URL — so an existing deployment that only sets BETTER_AUTH_URL
# keeps working unchanged. Auth redirects always follow BETTER_AUTH_URL.
APP_URL=https://flarestarter.example.com

# Repository link shown in the header, footer, docs nav and the `git clone`
# command. Blank → falls back to the template repo.
#
# To HIDE the repository link on your own site, set this to `-`. (Not blank:
# blank already means "use the template default". Every consumer guards on a
# falsy value, so `-` is the one spelling that renders no link at all.)
APP_GITHUB_URL=https://github.com/flarestarter/flarestarter

# Legal entity name for the copyright line (the company, e.g. "Acme Inc").
# Blank → falls back to APP_NAME.
APP_LEGAL_NAME=FlareStarter

# ── Analytics ───────────────────────────────────────────────────────────────

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX).
# Get it from GA4 → Admin → Data streams → Web → Measurement ID.
#
# Blank = the GA4 integration is not compiled into the build at all: no GA
# code in the bundle, no request to Google, and the production CSP does not
# allow Google's hosts. See src/features/analytics/ for the details.
GA_MEASUREMENT_ID=
