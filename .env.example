# Build-time configuration (Vite) — NOT `.dev.vars`.
#
# These values are read while `vite build` runs and are inlined into the bundle
# as literals. They are not runtime env vars: a Cloudflare var/secret only
# exists once the worker is running, which is far too late to keep a feature
# out of the bundle.
#
# Copy this file to `.env` (git-ignored) for local development, or set the
# variables in your CI environment for production builds.

# Google Analytics 4 measurement id (e.g. G-XXXXXXXXXX).
# Get it from GA4 → Admin → Data streams → Web → Measurement ID.
#
# Blank = the GA4 integration is not compiled into the build at all: no GA
# code in the bundle, no request to Google, and the production CSP does not
# allow Google's hosts. See src/features/analytics/ for the details.
GA_MEASUREMENT_ID=
